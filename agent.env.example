# Copy to agent.env in each project's dev container, then `./start_agent.sh`.
#
# Read by BOTH halves: start_agent.sh sources it for the resident agent, and
# context_bridge.mjs reads PROJECT_NAME/BROKER_URL out of it directly (looking
# for $AGENT_ENV, else agent.env beside context_bridge.mjs). That's why nothing
# per-project is hardcoded in .mcp.json -- rename a project here only.

PROJECT_NAME=payments                 # this project's name (agent + bridge)
PROJECT_REPO=/workspace               # path to the repo INSIDE this dev container
BROKER_URL=http://broker:8000         # broker service name on the shared network

# This dev container runs as root; the CLI refuses --dangerously-skip-permissions
# as root unless it believes it's sandboxed. Set this so bypassPermissions works.
IS_SANDBOX=1

# Subscription auth (run `claude setup-token` once on a machine with a browser).
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: only set if other containers can't reach this dev container by its
# hostname. Use this dev container's service/alias name on the shared network.
# The port named here is also the port the agent binds, unless PORT says
# otherwise -- so to move the agent off 9100, changing this line is enough.
# SELF_ENDPOINT=http://hrbc1-payments:9100

# Optional: both launchers find a Python 3.10+ on their own and reject one that
# does not actually run -- Windows' Microsoft Store alias is the usual culprit.
# Set this only if they pick the wrong one, or find none at all.
# AGENT_PYTHON=C:\Users\you\AppData\Local\Programs\Python\Python313\python.exe
